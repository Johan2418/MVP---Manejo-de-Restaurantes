// Esquema Prisma — Fase 1: dominio de reservas (multi-tenant).
//
// Convención multi-tenant:
// - Todo modelo de datos de negocio tiene un campo tenantId con índice.
// - Tenant agrupa uno o varios Restaurant (marcas con varias ubicaciones).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cliente del SaaS (un restaurante o grupo de restaurantes).
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants   Restaurant[]
  guests        Guest[]
  reservations  Reservation[]
  conversations Conversation[]
  integrations  Integration[]

  @@map("tenants")
}

/// Establecimiento (ubicación) dentro de un tenant.
model Restaurant {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                   String
  timezone               String   @default("America/Guayaquil")
  defaultDurationMinutes Int      @default(90)

  /// Teléfono real del restaurante (para reenvío de llamadas en el IVR).
  phone String?

  /// Número Twilio asignado al restaurante (destino de SMS/WhatsApp/llamadas).
  /// Los webhooks de Twilio se resuelven contra este campo.
  twilioPhoneNumber String?   @unique

  /// Cuántas horas antes de la reserva se envía el recordatorio (Fase 3).
  reminderHoursBefore Int      @default(2)

  /// Canal del recordatorio automático (Fase 3): PHONE = llamada IVR,
  /// SMS/WHATSAPP = mensaje. Las reservas originadas por teléfono siempre
  /// reciben recordatorio por llamada.
  reminderChannel Channel @default(WHATSAPP)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables        Table[]
  reservations  Reservation[]
  openingHours  OpeningHour[]
  conversations Conversation[]
  integrations  Integration[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("restaurants")
}

/// Horario de apertura por día de la semana (varias filas por día: almuerzo + cena).
model OpeningHour {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Domingo ... 6 = Sábado
  openTime  String // "12:00" hora local
  closeTime String // "23:00" hora local
  enabled   Boolean  @default(true)

  @@index([restaurantId])
  @@map("opening_hours")
}

/// Mesa del restaurante.
model Table {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name     String // "M1", "Terraza A", "Bar 3"...
  capacity Int
  zone     String?
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("tables")
}

/// Cliente / comensal. Consentimiento explícito según LOPDP (Ecuador).
model Guest {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  phone       String // E.164: +593...
  name        String
  email       String?
  notes       String?
  preferences String?
  consent     Boolean  @default(false)
  visits      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations  Reservation[]
  conversations Conversation[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("guests")
}

/// Reserva. Una mesa por reserva (las mesas combinables llegan en otra iteración).
model Reservation {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantId     String
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  guestId          String?
  guest            Guest?            @relation(fields: [guestId], references: [id], onDelete: SetNull)
  tableId          String?
  table            Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)

  startsAt         DateTime
  durationMinutes  Int               @default(90)
  partySize        Int
  status           ReservationStatus @default(REQUESTED)
  channel          Channel           @default(WEB)
  customerNotes    String?
  internalNotes    String?

  cancelledAt DateTime?
  completedAt DateTime?

  /// Cuándo se envió el recordatorio (Fase 3). Evita envíos duplicados.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, startsAt])
  @@index([tenantId])
  @@index([tableId, status])
  @@map("reservations")
}

/// Ciclo de vida de una reserva.
enum ReservationStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

/// Canal por el que se originó la reserva.
enum Channel {
  PHONE
  SMS
  WHATSAPP
  WEB
}

/// Estado de un hilo de conversación con un cliente.
enum ConversationStatus {
  OPEN
  ARCHIVED
}

/// Dirección de un mensaje dentro de una conversación.
enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// Estado de entrega de un mensaje saliente (reportado por el proveedor).
enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

/// Hilo de interacción por canal con un cliente (Fase 2 — Canales).
/// Un cliente + canal + número del restaurante = una conversación.
model Conversation {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  guestId      String?
  guest        Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)

  channel Channel

  /// Número del restaurante en el canal (ej. +593999999999 o whatsapp:+...).
  channelAddress String
  /// Número del cliente en el canal.
  peerAddress    String

  /// Identificador del hilo en el proveedor (WhatsApp conversation SID).
  providerThreadId String?

  status ConversationStatus @default(OPEN)

  /// Estado del chatbot (Fase 5): flujo de reserva en curso, etc.
  metadata Json?

  /// Mensajes entrantes sin leer (contador para el panel).
  unread Int @default(0)

  lastMessageAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]

  @@unique([restaurantId, channel, channelAddress, peerAddress])
  @@index([tenantId])
  @@index([restaurantId, lastMessageAt])
  @@map("conversations")
}

/// Mensaje dentro de una conversación.
model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction MessageDirection
  body      String
  mediaUrl  String?

  /// Identificador del mensaje/llamada en el proveedor (Twilio MessageSid/CallSid).
  /// Único: Twilio reintenta webhooks y este campo da idempotencia.
  providerSid String?
  status      MessageStatus @default(SENT)
  sentAt      DateTime      @default(now())

  @@unique([providerSid])
  @@index([conversationId, sentAt])
  @@map("messages")
}

/// Proveedor externo integrado (Fase 4 — Integraciones).
enum IntegrationProvider {
  GOOGLE_CALENDAR
  CALDAV
  CRM_HUBSPOT
}

/// Estado de una integración con un proveedor externo.
enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

/// Integración externa de un restaurante (Fase 4 — Integraciones).
/// Guarda las credenciales OAuth del proveedor en `credentials` (JSON) y la
/// configuración (calendarId, etc.) en `config`. Las credenciales NUNCA se
/// exponen por la API REST.
model Integration {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  provider IntegrationProvider
  status   IntegrationStatus      @default(DISCONNECTED)

  /// Tokens/credenciales del proveedor (JSON privado, no exponer).
  credentials Json?
  /// Configuración del usuario (ej. { calendarId: "primary" }).
  config Json?

  lastSyncedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, provider])
  @@index([tenantId])
  @@map("integrations")
}

/// Registro persistido de eventos de dominio (patrón outbox, Fase 3).
/// El bus sigue emitiendo en memoria; este registro garantiza trazabilidad y
/// permite reprocesar eventos sin perderlos si el proceso se reinicia.
model OutboxEvent {
  id          String   @id @default(cuid())
  name        String
  tenantId    String
  payload     Json
  status      String   @default("PENDING") // PENDING | PROCESSED
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@map("outbox_events")
}

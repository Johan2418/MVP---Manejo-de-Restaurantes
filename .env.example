# Copia este archivo a apps/api/.env y ajusta los valores.
# Las credenciales por defecto coinciden con docker-compose.yml (solo desarrollo).

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://reservas:reservas@localhost:5433/reservas?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# API
PORT=3001

# CORS: origenes permitidos para el frontend (coma separada)
CORS_ORIGINS="http://localhost:3000"

# --- Twilio (se activa en Fase 2 - canales) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_NUMBER=
